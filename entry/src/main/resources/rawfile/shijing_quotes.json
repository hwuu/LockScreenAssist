[
  {
    "text": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。",
    "category": "爱情",
    "source": "《诗经·周南·关雎》",
    "bg_color": "#1e3a8a",
    "bg_color_reason": "深蓝色象征河水的深邃，契合诗中河洲的意境"
  },
  {
    "text": "求之不得，寤寐思服。悠哉悠哉，辗转反侧。",
    "category": "爱情",
    "source": "《诗经·周南·关雎》",
    "bg_color": "#1e293b",
    "bg_color_reason": "深夜蓝表现夜不能寐的相思之情"
  },
  {
    "text": "桃之夭夭，灼灼其华。之子于归，宜其室家。",
    "category": "爱情",
    "season": "春",
    "source": "《诗经·周南·桃夭》",
    "bg_color": "#831843",
    "bg_color_reason": "深粉色呼应桃花的灼灼其华，展现新婚的喜庆"
  },
  {
    "text": "蒹葭苍苍，白露为霜。所谓伊人，在水一方。",
    "category": "思念",
    "season": "秋",
    "weather": "cold",
    "source": "《诗经·秦风·蒹葭》",
    "bg_color": "#164e63",
    "bg_color_reason": "墨青色表现秋水苍茫、薄雾笼罩的朦胧意境"
  },
  {
    "text": "溯洄从之，道阻且长。溯游从之，宛在水中央。",
    "category": "思念",
    "source": "《诗经·秦风·蒹葭》",
    "bg_color": "#0e7490",
    "bg_color_reason": "暗青色象征逆流而上的艰难与执着追寻"
  },
  {
    "text": "子衿青青，悠悠我心。纵我不往，子宁不嗣音。",
    "category": "思念",
    "source": "《诗经·郑风·子衿》",
    "bg_color": "#1e40af",
    "bg_color_reason": "钴蓝色呼应'青青子衿'的青色，表达深切思念"
  },
  {
    "text": "一日不见，如三秋兮。",
    "category": "思念",
    "source": "《诗经·王风·采葛》",
    "bg_color": "#92400e",
    "bg_color_reason": "红棕色象征秋天，呼应'三秋'的时光漫长感"
  },
  {
    "text": "死生契阔，与子成说。执子之手，与子偕老。",
    "category": "爱情",
    "source": "《诗经·邶风·击鼓》",
    "bg_color": "#3b0764",
    "bg_color_reason": "深紫罗兰色代表永恒的承诺与深情"
  },
  {
    "text": "愿言思伯，甘心首疾。",
    "category": "爱情",
    "source": "《诗经·卫风·伯兮》",
    "bg_color": "#581c87",
    "bg_color_reason": "深紫色表现相思成疾的深情"
  },
  {
    "text": "有美一人，清扬婉兮。邂逅相遇，适我愿兮。",
    "category": "爱情",
    "source": "《诗经·郑风·野有蔓草》",
    "bg_color": "#155e75",
    "bg_color_reason": "深暗青色映衬美人的清扬婉约"
  },
  {
    "text": "春日迟迟，卉木萋萋。仓庚喈喈，采蘩祁祁。",
    "category": "自然",
    "season": "春",
    "source": "《诗经·豳风·七月》",
    "bg_color": "#166534",
    "bg_color_reason": "深祖母绿展现春天草木萋萋的生机"
  },
  {
    "text": "四月维夏，六月徂暑。",
    "category": "自然",
    "season": "夏",
    "source": "《诗经·小雅·四月》",
    "bg_color": "#7c2d12",
    "bg_color_reason": "深棕红色表现夏日的炎热"
  },
  {
    "text": "秋日凄凄，百卉具腓。乱离瘼矣，爰其适归。",
    "category": "自然",
    "season": "秋",
    "source": "《诗经·小雅·四月》",
    "bg_color": "#713f12",
    "bg_color_reason": "深焦糖色呈现秋天的萧瑟凄凉"
  },
  {
    "text": "雨雪霏霏，见晛曰消。莫肯下遗，式救斯民。",
    "category": "自然",
    "season": "冬",
    "weather": "snowy",
    "source": "《诗经·小雅·雨无正》",
    "bg_color": "#374151",
    "bg_color_reason": "中灰蓝色展现雪天的阴沉天色"
  },
  {
    "text": "昔我往矣，杨柳依依。今我来思，雨雪霏霏。",
    "category": "离别",
    "season": "冬",
    "weather": "snowy",
    "source": "《诗经·小雅·采薇》",
    "bg_color": "#1f2937",
    "bg_color_reason": "暗蓝灰色表现离别时的凄凉与今昔对比"
  },
  {
    "text": "野有蔓草，零露溥兮。有美一人，婉如清扬。",
    "category": "自然",
    "weather": "sunny",
    "source": "《诗经·郑风·野有蔓草》",
    "bg_color": "#134e4a",
    "bg_color_reason": "暗绿松石色表现晨露与青草的清新"
  },
  {
    "text": "彼采萧兮，一日不见，如三秋兮。",
    "category": "思念",
    "season": "秋",
    "source": "《诗经·王风·采葛》",
    "bg_color": "#854d0e",
    "bg_color_reason": "深金棕色呼应秋天采萧的场景"
  },
  {
    "text": "七月流火，九月授衣。",
    "category": "时节",
    "season": "秋",
    "source": "《诗经·豳风·七月》",
    "bg_color": "#9a3412",
    "bg_color_reason": "褐橙色象征火星西流的秋夜"
  },
  {
    "text": "青青子衿，悠悠我心。",
    "category": "思念",
    "source": "《诗经·郑风·子衿》",
    "bg_color": "#075985",
    "bg_color_reason": "海洋蓝呼应青衿，表达悠远思念"
  },
  {
    "text": "东门之杨，其叶牂牂。昏以为期，明星煌煌。",
    "category": "约会",
    "source": "《诗经·陈风·东门之杨》",
    "bg_color": "#1e293b",
    "bg_color_reason": "深蓝灰色营造黄昏约会的浪漫氛围"
  },
  {
    "text": "行道迟迟，载渴载饥。我心伤悲，莫知我哀。",
    "category": "离别",
    "source": "《诗经·小雅·采薇》",
    "bg_color": "#451a03",
    "bg_color_reason": "暗棕色表现旅途的艰辛与离别的悲伤"
  },
  {
    "text": "维桑与梓，必恭敬止。靡瞻匪父，靡依匪母。",
    "category": "思乡",
    "source": "《诗经·小雅·小弁》",
    "bg_color": "#422006",
    "bg_color_reason": "深巧克力色象征故乡的土地与根脉"
  },
  {
    "text": "式微式微，胡不归。微君之故，胡为乎中露。",
    "category": "思乡",
    "source": "《诗经·邶风·式微》",
    "bg_color": "#1e293b",
    "bg_color_reason": "深夜蓝映衬黄昏思归的愁绪"
  },
  {
    "text": "女曰鸡鸣，士曰昧旦。子兴视夜，明星有烂。",
    "category": "生活",
    "source": "《诗经·郑风·女曰鸡鸣》",
    "bg_color": "#1a202c",
    "bg_color_reason": "午夜蓝表现黎明前的天色"
  },
  {
    "text": "投我以木瓜，报之以琼琚。匪报也，永以为好也。",
    "category": "友情",
    "source": "《诗经·卫风·木瓜》",
    "bg_color": "#4c1d95",
    "bg_color_reason": "深靛紫象征友谊的珍贵如琼琚"
  },
  {
    "text": "投我以木桃，报之以琼瑶。匪报也，永以为好也。",
    "category": "友情",
    "source": "《诗经·卫风·木瓜》",
    "bg_color": "#553c9a",
    "bg_color_reason": "薰衣草紫呼应琼瑶的温润光泽"
  },
  {
    "text": "绸缪束薪，三星在天。今夕何夕，见此良人。",
    "category": "爱情",
    "source": "《诗经·唐风·绸缪》",
    "bg_color": "#171923",
    "bg_color_reason": "深靛蓝营造星夜良缘的浪漫"
  },
  {
    "text": "河水洋洋，北流活活。施罛濊濊，鳣鲔发发。",
    "category": "自然",
    "source": "《诗经·卫风·河广》",
    "bg_color": "#0c4a6e",
    "bg_color_reason": "深天蓝色表现大河奔流的壮阔"
  },
  {
    "text": "谁谓河广，一苇杭之。谁谓宋远，跂予望之。",
    "category": "思念",
    "source": "《诗经·卫风·河广》",
    "bg_color": "#0369a1",
    "bg_color_reason": "湖蓝色表达跨越江河的思念之切"
  },
  {
    "text": "静女其姝，俟我于城隅。爱而不见，搔首踟蹰。",
    "category": "爱情",
    "source": "《诗经·邶风·静女》",
    "bg_color": "#701a75",
    "bg_color_reason": "梅红色映衬少女的娇羞与等待的焦急"
  },
  {
    "text": "如切如磋，如琢如磨。",
    "category": "修养",
    "source": "《诗经·卫风·淇奥》"
  },
  {
    "text": "瞻彼淇奥，绿竹猗猗。有匪君子，如切如磋。",
    "category": "修养",
    "source": "《诗经·卫风·淇奥》"
  },
  {
    "text": "温温恭人，如集于木。惴惴小心，如临于谷。",
    "category": "修养",
    "source": "《诗经·小雅·小旻》"
  },
  {
    "text": "战战兢兢，如临深渊，如履薄冰。",
    "category": "谨慎",
    "source": "《诗经·小雅·小旻》"
  },
  {
    "text": "他山之石，可以攻玉。",
    "category": "学习",
    "source": "《诗经·小雅·鹤鸣》"
  },
  {
    "text": "鹤鸣于九皋，声闻于野。鱼潜在渊，或在于渚。",
    "category": "哲理",
    "source": "《诗经·小雅·鹤鸣》"
  },
  {
    "text": "投我以桃，报之以李。",
    "category": "礼仪",
    "source": "《诗经·大雅·抑》"
  },
  {
    "text": "诲尔谆谆，听我藐藐。",
    "category": "教育",
    "source": "《诗经·大雅·抑》"
  },
  {
    "text": "匪风发兮，匪车偈兮。顾瞻周道，中心怛兮。",
    "category": "忧国",
    "source": "《诗经·邶风·匪风》"
  },
  {
    "text": "言者无罪，闻者足戒。",
    "category": "批评",
    "source": "《诗经·大序》"
  },
  {
    "text": "十月蟋蟀入我床下。穹窒熏鼠，塞向墐户。",
    "category": "生活",
    "season": "秋",
    "source": "《诗经·豳风·七月》"
  },
  {
    "text": "二之日凿冰冲冲，三之日纳于凌阴。",
    "category": "劳动",
    "season": "冬",
    "source": "《诗经·豳风·七月》"
  },
  {
    "text": "春日载阳，有鸣仓庚。女执懿筐，遵彼微行。",
    "category": "劳动",
    "season": "春",
    "source": "《诗经·豳风·七月》"
  },
  {
    "text": "采采卷耳，不盈顷筐。嗟我怀人，寘彼周行。",
    "category": "劳动",
    "source": "《诗经·周南·卷耳》"
  },
  {
    "text": "参差荇菜，左右流之。窈窕淑女，寤寐求之。",
    "category": "劳动",
    "source": "《诗经·周南·关雎》"
  },
  {
    "text": "采采芣苢，薄言采之。采采芣苢，薄言有之。",
    "category": "劳动",
    "source": "《诗经·周南·芣苢》"
  },
  {
    "text": "南有乔木，不可休思。汉有游女，不可求思。",
    "category": "哲理",
    "source": "《诗经·周南·汝坟》"
  },
  {
    "text": "无衣无褐，何以卒岁。",
    "category": "生活",
    "season": "冬",
    "source": "《诗经·豳风·七月》"
  },
  {
    "text": "女心伤悲，殆及公子同归。",
    "category": "婚姻",
    "source": "《诗经·召南·摽有梅》"
  },
  {
    "text": "摽有梅，其实七兮。求我庶士，迨其吉兮。",
    "category": "婚姻",
    "source": "《诗经·召南·摽有梅》"
  },
  {
    "text": "民之秉彝，好是懿德。",
    "category": "品德",
    "source": "《诗经·大雅·烝民》"
  },
  {
    "text": "天生烝民，有物有则。民之秉彝，好是懿德。",
    "category": "品德",
    "source": "《诗经·大雅·烝民》"
  },
  {
    "text": "高山仰止，景行行止。",
    "category": "敬仰",
    "source": "《诗经·小雅·车舝》"
  },
  {
    "text": "既明且哲，以保其身。",
    "category": "智慧",
    "source": "《诗经·大雅·烝民》"
  },
  {
    "text": "靡不有初，鲜克有终。",
    "category": "恒心",
    "source": "《诗经·大雅·荡》"
  },
  {
    "text": "多行不义必自毙。",
    "category": "正义",
    "source": "《诗经·小雅·巧言》"
  },
  {
    "text": "维号斯言，有伦有脊。",
    "category": "言行",
    "source": "《诗经·大雅·假乐》"
  },
  {
    "text": "乐只君子，万寿无疆。",
    "category": "祝福",
    "source": "《诗经·小雅·南山有台》"
  },
  {
    "text": "如月之恒，如日之升。",
    "category": "祝福",
    "source": "《诗经·小雅·天保》"
  },
  {
    "text": "如南山之寿，不骞不崩。",
    "category": "祝福",
    "source": "《诗经·小雅·天保》"
  },
  {
    "text": "嘤其鸣矣，求其友声。",
    "category": "友谊",
    "source": "《诗经·小雅·伐木》"
  },
  {
    "text": "既见君子，我心则喜。",
    "category": "友谊",
    "source": "《诗经·小雅·菁菁者莪》"
  },
  {
    "text": "有匪君子，如金如锡，如圭如璧。",
    "category": "品格",
    "source": "《诗经·卫风·淇奥》"
  },
  {
    "text": "巧言如簧，颜之厚矣。",
    "category": "讽刺",
    "source": "《诗经·小雅·巧言》"
  },
  {
    "text": "他人有心，予忖度之。",
    "category": "理解",
    "source": "《诗经·小雅·巧言》"
  },
  {
    "text": "知我者谓我心忧，不知我者谓我何求。",
    "category": "理解",
    "source": "《诗经·王风·黍离》"
  },
  {
    "text": "彼黍离离，彼稷之苗。行迈靡靡，中心摇摇。",
    "category": "感怀",
    "source": "《诗经·王风·黍离》"
  },
  {
    "text": "采葛采葛，首阳之巅。人之为言，苟亦无信。",
    "category": "诚信",
    "source": "《诗经·王风·采葛》"
  },
  {
    "text": "终风且暴，顾我则笑。谑浪笑敖，中心是悼。",
    "category": "情感",
    "source": "《诗经·邶风·终风》"
  },
  {
    "text": "邂逅相遇，与子偕臧。",
    "category": "友谊",
    "source": "《诗经·郑风·野有蔓草》"
  },
  {
    "text": "昔我往矣，杨柳依依。今我来思，雨雪霏霏。",
    "category": "时光",
    "season": "冬",
    "weather": "snowy",
    "source": "《诗经·小雅·采薇》"
  },
  {
    "text": "人生如寄，多忧何为。",
    "category": "人生",
    "source": "《诗经·唐风·山有枢》"
  },
  {
    "text": "山有木兮木有枝，心悦君兮君不知。",
    "category": "暗恋",
    "source": "《诗经·越人歌》"
  },
  {
    "text": "皎皎白驹，食我场苗。縶之维之，以永今朝。",
    "category": "惜时",
    "source": "《诗经·小雅·白驹》"
  },
  {
    "text": "所谓伊人，在水一方。",
    "category": "思念",
    "source": "《诗经·秦风·蒹葭》"
  },
  {
    "text": "绸缪束楚，三星在户。今夕何夕，见此粲者。",
    "category": "美好",
    "source": "《诗经·唐风·绸缪》"
  },
  {
    "text": "月出皎兮，佼人僚兮。舒窈纠兮，劳心悄兮。",
    "category": "思念",
    "source": "《诗经·陈风·月出》"
  },
  {
    "text": "关关雎鸠，在河之洲。",
    "category": "和谐",
    "source": "《诗经·周南·关雎》"
  },
  {
    "text": "风雨如晦，鸡鸣不已。既见君子，云胡不喜。",
    "category": "坚持",
    "weather": "rainy",
    "source": "《诗经·郑风·风雨》"
  },
  {
    "text": "青青子佩，悠悠我思。纵我不往，子宁不来。",
    "category": "思念",
    "source": "《诗经·郑风·子衿》"
  },
  {
    "text": "呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。",
    "category": "宴客",
    "source": "《诗经·小雅·鹿鸣》"
  },
  {
    "text": "泽陂汇汇，禾役役。",
    "category": "自然",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "鱼在在藻，有颁其首。王在在镐，岂乐饮酒。",
    "category": "自然",
    "source": "《诗经·小雅·鱼藻》"
  },
  {
    "text": "维南有箕，不可以簸扬。维北有斗，不可以挹酒浆。",
    "category": "哲理",
    "source": "《诗经·小雅·大东》"
  },
  {
    "text": "硕鼠硕鼠，无食我黍。三岁贯女，莫我肯顾。",
    "category": "愤懑",
    "source": "《诗经·魏风·硕鼠》"
  },
  {
    "text": "坎坎伐檀兮，置之河之干兮。河水清且涟猗。",
    "category": "劳动",
    "source": "《诗经·魏风·伐檀》"
  },
  {
    "text": "不素餐兮！",
    "category": "勤俭",
    "source": "《诗经·魏风·伐檀》"
  },
  {
    "text": "采采芣苢，薄言掇之。采采芣苢，薄言捋之。",
    "category": "劳动",
    "source": "《诗经·周南·芣苢》"
  },
  {
    "text": "葛之覃兮，施于中谷，维叶萋萋。",
    "category": "自然",
    "source": "《诗经·周南·葛覃》"
  },
  {
    "text": "螽斯羽，诜诜兮。宜尔子孙，振振兮。",
    "category": "祝福",
    "source": "《诗经·周南·螽斯》"
  },
  {
    "text": "桃之夭夭，灼灼其华。之子于归，宜其室家。",
    "category": "婚姻",
    "season": "春",
    "source": "《诗经·周南·桃夭》"
  },
  {
    "text": "宜其室家，宜其家人。",
    "category": "家庭",
    "source": "《诗经·周南·桃夭》"
  },
  {
    "text": "父兮生我，母兮鞠我。抚我畜我，长我育我。",
    "category": "感恩",
    "source": "《诗经·小雅·蓼莪》"
  },
  {
    "text": "欲报之德，昊天罔极。",
    "category": "感恩",
    "source": "《诗经·小雅·蓼莪》"
  },
  {
    "text": "凯风自南，吹彼棘心。棘心夭夭，母氏劬劳。",
    "category": "母爱",
    "source": "《诗经·邶风·凯风》"
  },
  {
    "text": "哀哀父母，生我劬劳。",
    "category": "感恩",
    "source": "《诗经·小雅·蓼莪》"
  },
  {
    "text": "兄弟阋于墙，外御其务。",
    "category": "兄弟",
    "source": "《诗经·小雅·棠棣》"
  },
  {
    "text": "常棣之华，鄂不韡韡。凡今之人，莫如兄弟。",
    "category": "兄弟",
    "source": "《诗经·小雅·棠棣》"
  },
  {
    "text": "死生契阔，与子成说。",
    "category": "承诺",
    "source": "《诗经·邶风·击鼓》"
  },
  {
    "text": "琴瑟在御，莫不静好。",
    "category": "和谐",
    "source": "《诗经·郑风·女曰鸡鸣》"
  },
  {
    "text": "巧笑倩兮，美目盼兮。",
    "category": "美人",
    "source": "《诗经·卫风·硕人》"
  },
  {
    "text": "手如柔荑，肤如凝脂。",
    "category": "美人",
    "source": "《诗经·卫风·硕人》"
  },
  {
    "text": "领如蝤蛴，齿如瓠犀。",
    "category": "美人",
    "source": "《诗经·卫风·硕人》"
  },
  {
    "text": "螓首蛾眉，巧笑倩兮，美目盼兮。",
    "category": "美人",
    "source": "《诗经·卫风·硕人》"
  },
  {
    "text": "燕燕于飞，差池其羽。",
    "category": "离别",
    "source": "《诗经·邶风·燕燕》"
  },
  {
    "text": "之子于归，远送于野。",
    "category": "离别",
    "source": "《诗经·邶风·燕燕》"
  },
  {
    "text": "瞻望弗及，泣涕如雨。",
    "category": "离别",
    "source": "《诗经·邶风·燕燕》"
  },
  {
    "text": "习习谷风，以阴以雨。",
    "category": "自然",
    "source": "《诗经·邶风·谷风》"
  },
  {
    "text": "黾勉同心，不宜有怒。",
    "category": "夫妻",
    "source": "《诗经·邶风·谷风》"
  },
  {
    "text": "采葑采菲，无以下体。",
    "category": "劝诫",
    "source": "《诗经·邶风·谷风》"
  },
  {
    "text": "日居月诸，照临下土。",
    "category": "天地",
    "source": "《诗经·邶风·日月》"
  },
  {
    "text": "乃如之人兮，逝不古处。",
    "category": "怨情",
    "source": "《诗经·邶风·日月》"
  },
  {
    "text": "胡能有定？宁不我顾。",
    "category": "怨情",
    "source": "《诗经·邶风·日月》"
  },
  {
    "text": "泛彼柏舟，亦泛其流。",
    "category": "漂泊",
    "source": "《诗经·邶风·柏舟》"
  },
  {
    "text": "耿耿不寐，如有隐忧。",
    "category": "忧思",
    "source": "《诗经·邶风·柏舟》"
  },
  {
    "text": "微我无酒，以敖以游。",
    "category": "排遣",
    "source": "《诗经·邶风·柏舟》"
  },
  {
    "text": "绿兮衣兮，绿衣黄里。",
    "category": "悼亡",
    "source": "《诗经·邶风·绿衣》"
  },
  {
    "text": "心之忧矣，曷维其已。",
    "category": "悼亡",
    "source": "《诗经·邶风·绿衣》"
  },
  {
    "text": "简兮简兮，方将万舞。",
    "category": "舞蹈",
    "source": "《诗经·邶风·简兮》"
  },
  {
    "text": "日之方中，在前上处。",
    "category": "舞蹈",
    "source": "《诗经·邶风·简兮》"
  },
  {
    "text": "有力如虎，执辔如组。",
    "category": "英武",
    "source": "《诗经·邶风·简兮》"
  },
  {
    "text": "泉源在左，淇水在右。",
    "category": "地理",
    "source": "《诗经·卫风·竹竿》"
  },
  {
    "text": "女子有行，远父母兄弟。",
    "category": "出嫁",
    "source": "《诗经·卫风·竹竿》"
  },
  {
    "text": "淇水汤汤，渐车帷裳。",
    "category": "自然",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "女也不爽，士贰其行。",
    "category": "怨情",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "士也罔极，二三其德。",
    "category": "批判",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "三岁为妇，靡室劳矣。",
    "category": "劳苦",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "夙兴夜寐，靡有朝矣。",
    "category": "勤劳",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "言既遂矣，至于暴矣。",
    "category": "怨情",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "兄弟不知，咥其笑矣。",
    "category": "孤苦",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "静言思之，躬自悼矣。",
    "category": "反省",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "及尔偕老，老使我怨。",
    "category": "怨情",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "淇则有岸，隰则有泮。",
    "category": "哲理",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "总角之宴，言笑晏晏。",
    "category": "回忆",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "信誓旦旦，不思其反。",
    "category": "誓言",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "反是不思，亦已焉哉。",
    "category": "决绝",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "考槃在涧，硕人之宽。",
    "category": "隐居",
    "source": "《诗经·卫风·考槃》"
  },
  {
    "text": "独寐寤言，永矢弗谖。",
    "category": "坚守",
    "source": "《诗经·卫风·考槃》"
  },
  {
    "text": "芄兰之支，童子佩觿。",
    "category": "少年",
    "source": "《诗经·卫风·芄兰》"
  },
  {
    "text": "虽则佩觿，能不我知。",
    "category": "少年",
    "source": "《诗经·卫风·芄兰》"
  },
  {
    "text": "伯兮朅兮，邦之桀兮。",
    "category": "英雄",
    "source": "《诗经·卫风·伯兮》"
  },
  {
    "text": "伯兮执殳，为王前驱。",
    "category": "征战",
    "source": "《诗经·卫风·伯兮》"
  },
  {
    "text": "自伯之东，首如飞蓬。",
    "category": "思念",
    "source": "《诗经·卫风·伯兮》"
  },
  {
    "text": "岂无膏沐，谁适为容。",
    "category": "思念",
    "source": "《诗经·卫风·伯兮》"
  },
  {
    "text": "其雨其雨，杲杲出日。",
    "category": "期待",
    "source": "《诗经·卫风·伯兮》"
  },
  {
    "text": "有狐绥绥，在彼淇梁。",
    "category": "描写",
    "source": "《诗经·卫风·有狐》"
  },
  {
    "text": "心之忧矣，之子无裳。",
    "category": "忧思",
    "source": "《诗经·卫风·有狐》"
  },
  {
    "text": "墙有茨，不可扫也。",
    "category": "隐喻",
    "source": "《诗经·鄘风·墙有茨》"
  },
  {
    "text": "中冓之言，不可道也。",
    "category": "隐私",
    "source": "《诗经·鄘风·墙有茨》"
  },
  {
    "text": "所可道也，言之丑也。",
    "category": "羞耻",
    "source": "《诗经·鄘风·墙有茨》"
  },
  {
    "text": "君子偕老，副笄六珈。",
    "category": "礼仪",
    "source": "《诗经·鄘风·君子偕老》"
  },
  {
    "text": "委委佗佗，如山如河。",
    "category": "威仪",
    "source": "《诗经·鄘风·君子偕老》"
  },
  {
    "text": "象服是宜，子之不淑，云如之何。",
    "category": "批判",
    "source": "《诗经·鄘风·君子偕老》"
  },
  {
    "text": "桑之未落，其叶沃若。",
    "category": "青春",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "于嗟鸠兮，无食桑葚。",
    "category": "警戒",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "于嗟女兮，无与士耽。",
    "category": "劝诫",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "士之耽兮，犹可说也。",
    "category": "劝诫",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "女之耽兮，不可说也。",
    "category": "劝诫",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "桑之落矣，其黄而陨。",
    "category": "衰老",
    "source": "《诗经·卫风·氓》"
  },
  {
    "text": "定之方中，作于楚宫。",
    "category": "建筑",
    "source": "《诗经·鄘风·定之方中》"
  },
  {
    "text": "揆之以日，作于楚室。",
    "category": "建筑",
    "source": "《诗经·鄘风·定之方中》"
  },
  {
    "text": "树之榛栗，椅桐梓漆。",
    "category": "农事",
    "source": "《诗经·鄘风·定之方中》"
  },
  {
    "text": "爰伐琴瑟，椅桐梓漆。",
    "category": "音乐",
    "source": "《诗经·鄘风·定之方中》"
  },
  {
    "text": "相鼠有皮，人而无仪。",
    "category": "讽刺",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "人而无仪，不死何为。",
    "category": "批判",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "相鼠有齿，人而无止。",
    "category": "讽刺",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "人而无止，不死何俟。",
    "category": "批判",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "相鼠有体，人而无礼。",
    "category": "讽刺",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "人而无礼，胡不遄死。",
    "category": "批判",
    "source": "《诗经·鄘风·相鼠》"
  },
  {
    "text": "载驰载驱，归唁卫侯。",
    "category": "奔走",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "驱马悠悠，言至于漕。",
    "category": "奔走",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "大夫跋涉，我心则忧。",
    "category": "忧国",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "既不我嘉，不能旋反。",
    "category": "坚持",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "视尔不臧，我思不远。",
    "category": "坚守",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "既不我嘉，不能旋济。",
    "category": "决心",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "视尔不臧，我思不閟。",
    "category": "坚守",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "陟彼阿丘，言采其蝱。",
    "category": "采集",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "女子善怀，亦各有行。",
    "category": "女性",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "许人尤之，众稚且狂。",
    "category": "批评",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "我行其野，蔽芾其樗。",
    "category": "行旅",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "昏姻之故，言就尔居。",
    "category": "婚姻",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "尔不我畜，复我邦家。",
    "category": "归家",
    "source": "《诗经·鄘风·载驰》"
  },
  {
    "text": "新台有泚，河水弥弥。",
    "category": "建筑",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "燕婉之求，蘧篨不鲜。",
    "category": "讽刺",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "新台有洒，河水浼浼。",
    "category": "建筑",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "燕婉之求，蘧篨不殄。",
    "category": "讽刺",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "鱼网之设，鸿则离之。",
    "category": "隐喻",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "燕婉之求，得此戚施。",
    "category": "讽刺",
    "source": "《诗经·邶风·新台》"
  },
  {
    "text": "二子乘舟，泛泛其景。",
    "category": "送别",
    "source": "《诗经·邶风·二子乘舟》"
  },
  {
    "text": "愿言思子，中心养养。",
    "category": "思念",
    "source": "《诗经·邶风·二子乘舟》"
  },
  {
    "text": "二子乘舟，泛泛其逝。",
    "category": "送别",
    "source": "《诗经·邶风·二子乘舟》"
  },
  {
    "text": "愿言思子，不瑕有害。",
    "category": "祝愿",
    "source": "《诗经·邶风·二子乘舟》"
  },
  {
    "text": "彼泽之陂，有蒲与荷。",
    "category": "自然",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "有美一人，伤如之何。",
    "category": "思念",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "寤寐无为，涕泗滂沱。",
    "category": "悲伤",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "彼泽之陂，有蒲与蕳。",
    "category": "自然",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "有美一人，硕大且卷。",
    "category": "美人",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "寤寐无为，中心悁悁。",
    "category": "忧思",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "彼泽之陂，有蒲菡萏。",
    "category": "自然",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "有美一人，硕大且俨。",
    "category": "美人",
    "source": "《诗经·陈风·泽陂》"
  },
  {
    "text": "寤寐无为，辗转伏枕。",
    "category": "失眠",
